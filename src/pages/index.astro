---
import Base from '../layouts/Base.astro';
import DealCard from '../components/DealCard.astro';
import CircularLoop from '../components/CircularLoop.astro';
import { getDeals, getPrincipals } from '../lib/deals';

const deals = getDeals();
const analyzed = deals.filter((d) => d.analysis && d.analysis.verdict !== 'pending');
const circular = deals.filter((d) => d.analysis?.verdict === 'circular');
const mixed    = deals.filter((d) => d.analysis?.verdict === 'mixed');
const buildout = deals.filter((d) => d.analysis?.verdict === 'buildout');
const principals = getPrincipals();

const totals = {
  deals: deals.length,
  analyzed: analyzed.length,
  circular: circular.length,
  buildout: buildout.length,
  principals: principals.length,
};

const featured = [...circular, ...mixed, ...buildout].slice(0, 6);
---
<Base
  title="busgen"
  description="Are the AI mega-deals industrial buildout or circular financial engineering? A catalog with structured analysis and pantheon framing."
>
  <section class="home-hero">
    <div class="home-hero__copy">
      <p class="eyebrow">A catalog of AI mega-deals</p>
      <h1>Industrial buildout, or a pantheon trading the same dollars in a circle?</h1>
      <p class="deck">
        The 2024–2026 AI capital cycle is structurally a small recurring
        cast — Altman, Huang, Nadella, Amodei, Hassabis — moving very large
        sums in patterns where customer, investor, and supplier collapse
        into one counterparty. This site catalogues the deals, scores
        each on a sustainability rubric, and renders the cast as the
        mythological court the industry increasingly resembles.
      </p>
      <div class="home-hero__cta">
        <a href="/deals/" class="btn btn--primary">Browse deals →</a>
        <a href="/pantheon/" class="btn">See the Pantheon</a>
      </div>
    </div>
    <div class="home-hero__viz">
      <CircularLoop />
    </div>
  </section>

  <section class="stats">
    <div><div class="stats__n">{totals.deals}</div><div class="eyebrow">deals catalogued</div></div>
    <div><div class="stats__n">{totals.analyzed}</div><div class="eyebrow">with verdict</div></div>
    <div><div class="stats__n" style="color: var(--oxblood)">{totals.circular}</div><div class="eyebrow">flagged circular</div></div>
    <div><div class="stats__n" style="color: var(--olive)">{totals.buildout}</div><div class="eyebrow">buildout</div></div>
    <div><div class="stats__n">{totals.principals}</div><div class="eyebrow">principals</div></div>
  </section>

  <hr class="rule" />

  <section>
    <div class="section-head">
      <h2 class="smallcaps">Featured verdicts</h2>
      <a href="/deals/">All deals →</a>
    </div>
    <div class="deal-grid">
      {featured.map((d) => <DealCard deal={d} />)}
    </div>
  </section>

  <hr class="rule" />

  <section class="prose">
    <h2 class="smallcaps">The thesis, briefly</h2>
    <p>
      AI industrial spend in 2024–2026 is structurally a small number of
      people moving very large sums in patterns that recur across deals.
      A chip company invests in a model company that commits to buying
      compute from a cloud company that buys chips from the chip company.
      The same dollars are recognized as investment gains, cloud
      revenue, and chip orders on three separate income statements.
    </p>
    <p>
      Following Jill Lepore's observation that AI governance has
      collapsed into the personalities of a few private actors, this
      site argues the same about AI capital flows. The Greco-Roman
      framing is half-joke and half-argument: a market in which twelve
      figures recur as gods of overlapping domains resembles a
      mythological court more than a competitive market.
    </p>
    <p>
      Deal data is from <a href="https://github.com/jstwng/compute-deal-map-data">jstwng/compute-deal-map-data</a> (CC&nbsp;BY&nbsp;4.0). Every deal carries a primary-source URL. The principal mappings, sustainability rubric, and verdicts are this project's contribution.
    </p>
  </section>
</Base>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3rem;
    align-items: center;
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2.5rem;
  }
  @media (max-width: 820px) {
    .home-hero { grid-template-columns: 1fr; gap: 1.5rem; }
    .home-hero__viz { order: -1; }
  }
  .home-hero h1 {
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.08;
    max-width: 18ch;
    margin-top: 0.3rem;
  }
  .home-hero .deck {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--ink-soft);
    max-width: 52ch;
    margin: 1rem 0 1.6rem;
    line-height: 1.45;
  }
  .home-hero__cta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--ink);
    background: transparent;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    transition: background 120ms, color 120ms;
  }
  .btn:hover { background: var(--ink); color: var(--bg); }
  .btn--primary { background: var(--ink); color: var(--bg); }
  .btn--primary:hover { background: var(--gilt); border-color: var(--gilt); color: var(--bg); }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0;
    font-family: var(--serif);
  }
  .stats__n {
    font-size: 2.6rem;
    line-height: 1;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.2rem;
  }
</style>
