---
import Base from '../../layouts/Base.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import IncentiveFlow from '../../components/IncentiveFlow.astro';
import { getDeals, getPrincipals } from '../../lib/deals';
import type { RubricItem } from '../../lib/deals';
import { mdToHtml } from '../../lib/md';

export async function getStaticPaths() {
  return getDeals().map((d) => ({ params: { id: d.id }, props: { deal: d } }));
}

const { deal } = Astro.props;
const a = deal.analysis;
const principalMap = new Map(getPrincipals().map((p) => [p.slug, p]));

function scoreClass(s: number | null): string {
  if (s == null) return 'score--null';
  if (s <= 1) return 'score--low';
  if (s === 2) return 'score--mid';
  return 'score--high';
}
function fmtCrit(key: string): string {
  return key.replaceAll('_', ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

const rubricEntries: [string, RubricItem][] = a?.rubric
  ? (Object.entries(a.rubric) as [string, RubricItem][])
  : [];

const involvedPrincipals = (a?.principals_involved ?? [])
  .map((slug) => principalMap.get(slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---
<Base title={`${deal.source_name} → ${deal.target_name}`} description={deal.description}>
  <p class="eyebrow">Deal · {deal.date_display}</p>
  <div class="deal-head">
    <h1>{deal.source_name} → {deal.target_name}</h1>
    <div style="display: flex; gap: 0.6rem; align-items: center">
      <VerdictBadge verdict={a?.verdict} />
      <span class="id">{deal.id}</span>
    </div>
  </div>

  <p class="prose" style="font-family: var(--serif); font-size: 1.15rem; font-style: italic; color: var(--ink-soft); margin-top: 0.4rem">
    {deal.description}
  </p>

  <IncentiveFlow deal={deal} />

  <section class="prose">
    <p style="font-size: 0.9rem; color: var(--ink-soft)">
      <strong>Type:</strong> {deal.deal_type.replaceAll('_', ' ')} ·
      <strong>Date:</strong> {deal.date_display} ·
      <strong>Value:</strong> {deal.value_display ?? '—'} ·
      <a href={deal.source_url}>Primary source</a>
    </p>
  </section>

  {involvedPrincipals.length > 0 && (
    <section style="margin-top: 2rem">
      <p class="eyebrow">Principals involved</p>
      <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 0.5rem">
        {involvedPrincipals.map((p) => (
          <a href={`/pantheon/${p.slug}/`} style="text-decoration: none; color: var(--ink)">
            <span style="font-family: var(--serif); font-style: italic; color: var(--gilt); font-size: 1.2rem">{p.pantheon.god}</span>
            <span style="display: block; font-family: var(--serif); font-size: 1.05rem">{p.name}</span>
            <span class="eyebrow">{p.pantheon.epithet}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {!a && (
    <section class="prose" style="margin-top: 2rem">
      <hr class="rule" />
      <h2 class="smallcaps">No analysis yet</h2>
      <p>
        This deal is catalogued from the upstream dataset but hasn't been analyzed yet. Add an overlay at <code>analysis/{deal.id}.yml</code> (copy from <code>analysis/_template.yml</code>).
      </p>
    </section>
  )}

  {a && rubricEntries.length > 0 && (
    <section>
      <hr class="rule" />
      <h2 class="smallcaps">Sustainability rubric</h2>
      <p class="prose" style="color: var(--ink-soft)">
        Each criterion scored 0–3. Score reflects this project's analytical reading of the deal as disclosed; it is not from the upstream dataset.
      </p>
      <div class="rubric">
        {rubricEntries.map(([key, item]) => (
          <div class="rubric-row">
            <div class="crit">{fmtCrit(key)}</div>
            <div class={`score ${scoreClass(item.score)}`}>{item.score ?? '—'}</div>
            <div class="note">{item.note}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  {a?.incentive_map && (
    <section class="prose">
      <hr class="rule" />
      <h2 class="smallcaps">Incentive map</h2>
      <div set:html={mdToHtml(a.incentive_map)} />
    </section>
  )}

  {a?.circularity_notes && (
    <section class="prose">
      <hr class="rule" />
      <h2 class="smallcaps">Circularity notes</h2>
      <div set:html={mdToHtml(a.circularity_notes)} />
    </section>
  )}

  {a?.illustration_prompt && (
    <section class="prose">
      <hr class="rule" />
      <h2 class="smallcaps">
        Illustration brief
        <span style="font-style: italic; font-size: 0.85rem; color: var(--ink-soft); margin-left: 0.5rem">
          ({a.illustration_tone})
        </span>
      </h2>
      <p style="font-style: italic; color: var(--ink-soft)">{a.illustration_prompt}</p>
    </section>
  )}
</Base>
