---
import Base from '../../layouts/Base.astro';
import PantheonFigure from '../../components/PantheonFigure.astro';
import { getPrincipals, getDealsByPrincipal } from '../../lib/deals';

const principals = getPrincipals();
const principalsWithCounts = principals
  .map((p) => ({ p, count: getDealsByPrincipal(p.slug).length }))
  .sort((a, b) => b.count - a.count);
---
<Base title="Pantheon" description="The recurring cast — twelve principals as a mythological court.">
  <p class="eyebrow">The recurring cast</p>
  <h1>The Pantheon</h1>
  <p class="prose">
    The thesis is that AI industrial spend is structurally a small number of
    figures moving very large sums in patterns that recur across deals. Here
    they are, as a court: a forge god, a messenger, a sky father, a hunter,
    a temperate prophet, an old titan, and the rest. Each god's appearances
    across deals are the recurring cast made visible.
  </p>
  <p class="prose" style="color: var(--ink-soft)">
    The analogs are an analytical claim, not a costume. They commit to a
    reading of each principal's role in the market — Hephaestus
    forges what every other god needs, Hermes makes the deals, Cronus
    is the old titan tolerated by his successors — and let the joke do
    work the spreadsheet can't.
  </p>

  <div class="pantheon-grid">
    {principalsWithCounts.map(({ p, count }) => (
      <div style="position: relative">
        <PantheonFigure principal={p} />
        <div style="position: absolute; top: 1.1rem; right: 1.2rem; font-family: var(--serif); font-size: 0.85rem; color: var(--ink-soft)">
          {count} {count === 1 ? 'deal' : 'deals'}
        </div>
      </div>
    ))}
  </div>
</Base>
