---
import type { Deal } from '../lib/deals';
import VerdictBadge from './VerdictBadge.astro';

interface Props { deal: Deal; }
const { deal } = Astro.props;
---
<a class="deal-card" href={`/deals/${deal.id}/`}>
  <div class="flow">
    {deal.source_name}<span class="arrow">→</span>{deal.target_name}
  </div>
  <div class="desc">{deal.description}</div>
  <div class="meta">
    <span>{deal.date_display}</span>
    <span>{deal.value_display ?? '—'}</span>
  </div>
  <div class="meta">
    <span style="text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.7rem">
      {deal.deal_type.replaceAll('_', ' ')}
    </span>
    <VerdictBadge verdict={deal.analysis?.verdict} />
  </div>
</a>
