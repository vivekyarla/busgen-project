---
// Six-node hexagonal loop showing the canonical 2024–2026 circular pattern.
// Hand-positioned; doesn't need to be data-driven for the prototype.
//
// Positions on a hexagon, center (300, 300), radius 195:
//   top         (300, 105)   NVIDIA
//   upper-right (469, 202)   Microsoft
//   lower-right (469, 398)   Oracle
//   bottom      (300, 495)   OpenAI
//   lower-left  (131, 398)   CoreWeave
//   upper-left  (131, 202)   AMD
---
<figure class="circular-loop" aria-label="Canonical circular deal pattern">
  <svg viewBox="0 0 600 600" role="img" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="arrow-gilt" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#8b6f1a" />
      </marker>
      <marker id="arrow-ox" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#8b1c1c" />
      </marker>
    </defs>

    {/* Background guide arc */}
    <circle cx="300" cy="300" r="195" fill="none" stroke="#c9bfa6" stroke-dasharray="2 6" />

    {/* --- Forward edges (gilt) --- */}
    {/* NVIDIA -> Microsoft (chip supply) */}
    <path d="M 340 130 Q 430 130 460 175" fill="none" stroke="#8b6f1a" stroke-width="1.4" marker-end="url(#arrow-gilt)" />
    {/* Microsoft -> OpenAI (Azure exclusive) */}
    <path d="M 459 240 Q 430 410 340 480" fill="none" stroke="#8b6f1a" stroke-width="1.4" marker-end="url(#arrow-gilt)" />
    {/* OpenAI -> Oracle (Stargate compute) */}
    <path d="M 340 480 Q 450 470 470 430" fill="none" stroke="#8b6f1a" stroke-width="1.4" marker-end="url(#arrow-gilt)" />
    {/* Oracle -> NVIDIA (chip purchase) */}
    <path d="M 470 360 Q 480 200 340 130" fill="none" stroke="#8b6f1a" stroke-width="1.4" marker-end="url(#arrow-gilt)" />
    {/* NVIDIA -> CoreWeave (invest + supply) */}
    <path d="M 270 135 Q 145 240 145 365" fill="none" stroke="#8b6f1a" stroke-width="1.4" marker-end="url(#arrow-gilt)" />
    {/* CoreWeave -> OpenAI (compute) */}
    <path d="M 175 425 Q 230 490 270 487" fill="none" stroke="#8b6f1a" stroke-width="1.4" marker-end="url(#arrow-gilt)" />
    {/* OpenAI -> AMD (chip "purchase") */}
    <path d="M 265 478 Q 130 470 130 235" fill="none" stroke="#8b6f1a" stroke-width="1.4" marker-end="url(#arrow-gilt)" />

    {/* --- Reverse / equity edges (oxblood) --- */}
    {/* AMD -> OpenAI (warrants) */}
    <path d="M 165 230 Q 240 460 285 482" fill="none" stroke="#8b1c1c" stroke-width="1.6" marker-end="url(#arrow-ox)" />
    {/* OpenAI -> Microsoft (equity investment back) */}
    <path d="M 320 480 Q 410 410 455 245" fill="none" stroke="#8b1c1c" stroke-width="1.6" marker-end="url(#arrow-ox)" />
    {/* OpenAI -> CoreWeave (equity stake via $350M shares) */}
    <path d="M 280 490 Q 170 480 155 425" fill="none" stroke="#8b1c1c" stroke-width="1.6" marker-end="url(#arrow-ox)" />

    {/* Nodes */}
    <g font-family="Hoefler Text, Garamond, Georgia, serif" font-size="18" text-anchor="middle">
      <g transform="translate(300 105)">
        <circle r="42" fill="#f5efe2" stroke="#1a1612" stroke-width="1.4" />
        <text y="5">NVIDIA</text>
      </g>
      <g transform="translate(469 202)">
        <circle r="42" fill="#f5efe2" stroke="#1a1612" stroke-width="1.4" />
        <text y="5">Microsoft</text>
      </g>
      <g transform="translate(469 398)">
        <circle r="42" fill="#f5efe2" stroke="#1a1612" stroke-width="1.4" />
        <text y="5">Oracle</text>
      </g>
      <g transform="translate(300 495)">
        <circle r="48" fill="#f5efe2" stroke="#1a1612" stroke-width="1.8" />
        <text y="5" font-style="italic">OpenAI</text>
      </g>
      <g transform="translate(131 398)">
        <circle r="42" fill="#f5efe2" stroke="#1a1612" stroke-width="1.4" />
        <text y="5">CoreWeave</text>
      </g>
      <g transform="translate(131 202)">
        <circle r="42" fill="#f5efe2" stroke="#1a1612" stroke-width="1.4" />
        <text y="5">AMD</text>
      </g>
    </g>

    {/* Center caption */}
    <g text-anchor="middle" font-family="Hoefler Text, Garamond, Georgia, serif">
      <text x="300" y="295" font-size="13" font-style="italic" fill="#4a4339" letter-spacing="1">the recurring cast</text>
      <text x="300" y="318" font-size="11" fill="#4a4339">customer · investor · supplier</text>
      <text x="300" y="334" font-size="11" fill="#4a4339">collapse into one counterparty</text>
    </g>
  </svg>
  <figcaption>
    <span style="color: var(--gilt)">Gilt</span>: announced deal direction (compute spend, chip purchases). <span style="color: var(--oxblood)">Oxblood</span>: reverse flow closing the loop — equity, warrants, in-kind credits.
  </figcaption>
</figure>

<style>
  .circular-loop {
    margin: 0;
    padding: 0;
  }
  .circular-loop svg {
    width: 100%;
    max-width: 520px;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .circular-loop figcaption {
    text-align: center;
    font-size: 0.82rem;
    color: var(--ink-soft);
    margin-top: 0.8rem;
    max-width: 48ch;
    margin-left: auto;
    margin-right: auto;
  }
</style>
